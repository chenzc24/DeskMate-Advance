{
  "schema_version": "1.0",
  "profile_id": "laptop",
  "camera": {
    "kind": "local",
    "source_id": "droidcam_front_shared_camera",
    "device_index": 1,
    "backend": "msmf",
    "width": 640,
    "height": 480,
    "fps": 30.0,
    "open_timeout_ms": 5000,
    "read_timeout_ms": 2000
  },
  "dealer": {
    "adapter": "simulated",
    "device_id": "simulated-phone-front-ad-dealer",
    "protocol_version": "2.0",
    "physical_motion": false,
    "enabled": true
  },
  "perception": {
    "identity_config": "configs/perception/face_identity_session.json",
    "gesture_config": "configs/perception/actions_laptop_pilot.json",
    "speech_config": "configs/perception/actions_speech_pilot.json",
    "speaker_config": "configs/perception/speaker_verification_session.json",
    "attribution_config": "configs/perception/actor_binding_session.json",
    "card_config": "configs/perception/cards_lgd_pilot.json",
    "card_geometry_config": "configs/perception/card_view_cycle_robot_development_v1.json",
    "calibration_id": "phone-front-state-directed-full-frame-development-v1",
    "target_geometry_validated": false
  },
  "timeouts": {
    "visual_settle_ms": 5000,
    "dealer_command_ms": 5000,
    "card_visual_ms": 60000
  },
  "controls": ["laptop_keyboard"],
  "speech": {
    "enabled": true,
    "device": "Virtual Mic (AudioRelay Wave)",
    "capture_sample_rate_hz": 44100
  },
  "logging": {
    "root": "runs/runtime/phone-front-ad-audiorelay"
  }
}
